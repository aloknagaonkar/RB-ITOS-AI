+def archive_authenticated_capture(db, snapshot, pin, *, as_of):
+    """Store original authenticated account evidence; no ownership permission."""
+    need(db.in_transaction, "CAPTURE_ARCHIVE_TRANSACTION_REQUIRED")
+    verify(snapshot, pin, as_of=as_of)
+    need(
+        snapshot.get("profile_verified_before_and_after") is True
+        and snapshot.get("account_position_rows_complete") is True
+        and snapshot.get("source_atomic") is False
+        and snapshot.get("position_fill_linkage_verified") is False
+        and snapshot.get("live_pnl") is None,
+        "CAPTURE_ARCHIVE_AUTHORITY_INVALID",
+    )
+    need(
+        all(isinstance(snapshot.get(k), list)
+            for k in ("orders", "trades", "positions")),
+        "CAPTURE_ARCHIVE_LISTS_REQUIRED",
+    )
+    from .ownership_checks.bridge import validate_account_rows
+    validate_account_rows(snapshot)
+    sid = snapshot.get("snapshot_id")
+    need(
+        isinstance(sid, str) and 0 < len(sid) <= 200
+        and sid.strip() == sid
+        and not any(ord(c) < 32 for c in sid),
+        "CAPTURE_ARCHIVE_ID_INVALID",
+    )
+    raw = json.dumps(
+        snapshot, sort_keys=True, separators=(",", ":"), allow_nan=False
+    )
+    need(len(raw.encode()) <= 2_000_000, "CAPTURE_ARCHIVE_TOO_LARGE")
+    fingerprint = sha(snapshot)
+    db.execute(
+        "CREATE TABLE IF NOT EXISTS preparation_account_captures("
+        "id TEXT PRIMARY KEY,fingerprint TEXT NOT NULL,data TEXT NOT NULL)"
+    )
+    old = db.execute(
+        "SELECT fingerprint,data FROM preparation_account_captures WHERE id=?",
+        (sid,),
+    ).fetchone()
+    if old:
+        need(
+            old[0] == fingerprint == sha(json.loads(old[1])),
+            "CAPTURE_ARCHIVE_ID_CONFLICT",
+        )
+        need(json.loads(old[1]) == snapshot, "CAPTURE_ARCHIVE_CONTENT_CONFLICT")
+    else:
+        db.execute(
+            "INSERT INTO preparation_account_captures VALUES(?,?,?)",
+            (sid, fingerprint, raw),
+        )
+    return True
 
 
