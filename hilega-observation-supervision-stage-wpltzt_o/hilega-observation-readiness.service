After=hilega-api.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/aloknagaonkar46/RB-ITOS-AI
Environment=PYTHONPATH=/home/aloknagaonkar46/RB-ITOS-AI/backend:/home/aloknagaonkar46/RB-ITOS-AI
Environment=HILEGA_READINESS_AUTO_REPAIR=0
