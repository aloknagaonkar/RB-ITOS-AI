HASHES=json.loads(r'''{"hilega_policy_live/config.template.json":"b5e6b92aaebd6fee8adfefcca23f5c8475358c5af4fea48cf4c0c1eba07dca16","hilega_policy_live/limits.template.json":"186aacf182d82446375f8ce0c6d302de900b1b5a48fff755a4513ace4d269dde","hilega_policy_live/observer.py":"3d16ab4bf6a318a269f5659f5d17c9ea44e40e8daa63cbf2cd78fd1d7dc006fb","hilega_policy_live/publisher.py":"6c30ce7ac06354c1d05dd329ef2afe2cc0f0ea292dd9b1a758f34f30091308e8","scripts/hilega_policy_observer_service.py":"0300d7d4172af7f735829d5f7a50a6f1518ca9d17b4ffec405e8d33f2cd86d12","scripts/start_hilega_policy_observer.sh":"3f8b358c5612d1d031b88122c940f7f6109a1b7e1df2758119719a52f32de39b","scripts/status_hilega_policy_observer.sh":"e2434b58b50a83d5aceaf70ac16ada4df2b0633343a2f11093b50e8c433c5ec3","scripts/stop_hilega_policy_observer.sh":"88f78fe7dbe036da6a9d04f4ab79f2a32dee88213f1a68512ee8ba93274da79d"}''')

def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else None

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    group=parser.add_mutually_exclusive_group()
    group.add_argument('--check',action='store_true')
    group.add_argument('--test',action='store_true')
    args=parser.parse_args()
    root=Path.cwd()
    if not (root/'backend/market_lab').is_dir():parser.error('Run from the repository root')
    plan=dict(FILES)
    for relative,content in FILES.items():
        if hashlib.sha256(content.encode()).hexdigest()!=HASHES[relative]:
            raise SystemExit('PAYLOAD_HASH_MISMATCH:'+relative)
        if digest(root/relative) not in (None,HASHES[relative]):
            raise SystemExit('SOURCE_HASH_MISMATCH:'+relative)
    # Preserve all other startup behavior and the VWAP collector hooks.
    for action in ('start','stop','status'):
        relative='scripts/'+action+'.sh'
        path=root/relative
        source=path.read_text()
        hook='bash "$ROOT/scripts/'+action+'_hilega_policy_observer.sh" || echo "Policy observer: '+action+' warning"'
        if hook in source:continue
        if action=='status':
            plan[relative]=source.rstrip()+'\n\n'+hook+'\n'
        else:
            anchors=[line for line in source.splitlines() if line.strip().startswith('bash "$ROOT/scripts/'+action+'_hilega_vwap_collector.sh"')]
            if len(anchors)!=1:raise SystemExit('EXPECTED_VWAP_SERVICE_HOOK_MISSING:'+relative)
            anchor=anchors[0]
            replacement=anchor+'\n'+hook if action=='start' else hook+'\n'+anchor
            plan[relative]=source.replace(anchor,replacement,1)
    config=root/'hilega_policy_live/config.json'
    if not config.exists():plan['hilega_policy_live/config.json']=FILES['hilega_policy_live/config.template.json']
    print(json.dumps(dict(status='VALIDATED',files=list(plan),orders_sent=False,tests_run=False)),flush=True)
    if args.check:return
    if args.test:
        with tempfile.TemporaryDirectory(prefix='hilega-policy-live-tests-') as folder:
            temporary=Path(folder)
            for relative,content in FILES.items():
                target=temporary/'files'/relative;target.parent.mkdir(parents=True,exist_ok=True);target.write_text(content)
            for relative,content in TESTS.items():
                target=temporary/'tests'/relative;target.parent.mkdir(parents=True,exist_ok=True);target.write_text(content)
            result=subprocess.run([sys.executable,'-m','pytest','-q',str(temporary/'tests')],cwd=temporary)
            raise SystemExit(result.returncode)
    backup=root/'backups'/('policy-live-'+datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ'))
    backup.mkdir(parents=True)
    created=[]
    for relative,content in plan.items():
        target=root/relative
        if target.exists() and target.read_text()==content:continue
        if target.exists():
            old=backup/relative;old.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(target,old)
        else:created.append(relative)
        target.parent.mkdir(parents=True,exist_ok=True)
        temporary=target.with_name(target.name+'.policy.tmp');temporary.write_text(content,encoding='utf-8');os.replace(temporary,target)
    (backup/'created-files.json').write_text(json.dumps(created,indent=2))
    print(json.dumps(dict(status='APPLIED',backup=str(backup),services_started=False,orders_sent=False,
                         activation='CONFIGURATION_AND_VM_VALIDATION_REQUIRED',tests_run=False)))

if __name__=='__main__':main()
