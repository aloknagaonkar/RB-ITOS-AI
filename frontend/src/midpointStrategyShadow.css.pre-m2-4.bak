.midpoint-page{gap:18px}.mp-modebar{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:12px 14px;border:1px solid #2a3d49;background:#101f28;border-radius:8px}.mp-modebar>div{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.mp-modebar small{color:#7691a2;font-size:9px}.mp-replay-controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.mp-replay-controls select{min-width:300px}.mp-replay-banner{display:flex;gap:14px;align-items:center;flex-wrap:wrap;padding:11px 14px;border:1px solid #685b38;background:#2b281b;border-radius:7px;color:#d9c989}.mp-replay-banner b{color:#e4c379}.mp-replay-banner small{color:#9f936c}.mp-summary{grid-template-columns:repeat(3,minmax(0,1fr))}.mp-lifecycle-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.mp-card{background:#13232d;border:1px solid #2a3d49;border-top:2px solid #607d8c;border-radius:8px;padding:14px}.mp-card span{display:block;color:#809aaa;text-transform:uppercase;font-size:9px;letter-spacing:.7px}.mp-card b{display:block;margin:8px 0;color:#d7e4eb;font-size:14px}.mp-card small{font-size:9px;color:#7691a2}.mp-card.mp-entry{border-top-color:#52c49f}.mp-card.mp-positive{border-top-color:#57c9c0}.mp-card.mp-warning{border-top-color:#d3a94a}.mp-card.mp-rescue{border-top-color:#c777c7}.mp-card.mp-terminal{border-top-color:#d76d7b}.mp-card.mp-boundary{border-top-color:#9272d4}.mp-card.mp-midpoint{border-top-color:#5d94d8}.mp-table{min-width:1450px}.mp-table-scroll{max-height:620px}.mp-table tbody tr.mp-entry,.mp-minute-table tbody tr.mp-entry{background:#142c29}.mp-table tbody tr.mp-positive,.mp-minute-table tbody tr.mp-positive{background:#142b2d}.mp-table tbody tr.mp-warning,.mp-minute-table tbody tr.mp-warning{background:#302a1b}.mp-table tbody tr.mp-rescue,.mp-minute-table tbody tr.mp-rescue{background:#2d2131}.mp-table tbody tr.mp-terminal,.mp-minute-table tbody tr.mp-terminal{background:#312126}.mp-table tbody tr.mp-boundary,.mp-minute-table tbody tr.mp-boundary{background:#221f32}.mp-table tbody tr.mp-midpoint,.mp-minute-table tbody tr.mp-midpoint{background:#1b2735}.mp-reason{max-width:280px;white-space:normal;text-align:left!important}.mp-audit-detail .shadow-detail-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.mp-minute-scroll{max-height:720px}.mp-minute-table{min-width:1320px}.mp-minute-table th{position:sticky;top:0;z-index:2}.mp-minute-table td:nth-child(9){min-width:430px;white-space:normal;text-align:left}.mp-minute-plain{background:#11202a}.mp-minute-events{display:flex;flex-direction:column;gap:6px}.mp-minute-event{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:7px 8px;border:1px solid #2f4654;border-radius:6px;background:#132630}.mp-minute-event>div{display:flex;flex-direction:column;gap:2px}.mp-minute-event b{font-size:10px}.mp-minute-event small{font-size:9px;color:#89a0ad}.mp-no-event{color:#58707f}.mp-data-status{display:inline-block;padding:3px 6px;border-radius:5px;border:1px solid #315365;color:#8fb8c7;font-size:8px;letter-spacing:.4px}.mp-data-status.warn{border-color:#6c5b35;color:#d7b967}.mp-inline-detail-row>td{padding:0!important;background:#0c1820!important;border-top:1px solid #35505f!important;border-bottom:1px solid #35505f!important}.mp-inline-audit{margin:0;padding:16px 18px 20px;background:#0e1b23;box-shadow:inset 3px 0 0 #4d9fb3}.mp-inline-audit-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid #2a3d49}.mp-inline-audit-head>div{display:flex;flex-direction:column;gap:3px}.mp-inline-audit-head span{font-size:9px;letter-spacing:1px;color:#66c7be}.mp-inline-audit-head b{font-size:13px;color:#d7e4eb}.mp-inline-audit-head small{font-size:9px;color:#7893a3}.mp-inline-audit .hilega-audit-section pre{max-height:320px;overflow:auto}.mp-inline-audit .shadow-detail-grid{grid-template-columns:repeat(4,minmax(0,1fr))}@media(max-width:1100px){.mp-summary,.mp-lifecycle-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.mp-audit-detail .shadow-detail-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.mp-summary,.mp-lifecycle-grid,.mp-audit-detail .shadow-detail-grid{grid-template-columns:1fr}.mp-replay-controls{width:100%;align-items:stretch;flex-direction:column}.mp-replay-controls select{min-width:0;width:100%}.mp-minute-table td:nth-child(9){min-width:320px}}
